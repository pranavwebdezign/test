{
    "name": "changefluent/quote-manager",
    "description": "ChangeFluent Quote Manager WordPress Plugin",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {},
    "suggest": {
        "mpdf/mpdf": "Enables full PDF generation with CSS support (recommended)",
        "setasign/fpdf": "Lightweight alternative PDF generation"
    },
    "autoload": {
        "psr-4": {}
    },
    "config": {
        "optimize-autoloader": true,
        "vendor-dir": "vendor"
    }
}
